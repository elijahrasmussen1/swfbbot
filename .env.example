# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The application (client) ID of your Discord bot
DISCORD_CLIENT_ID=

# The guild (server) ID (optional, used for server-scoped features)
DISCORD_GUILD_ID=

# Roblox Open Cloud API key from https://create.roblox.com/dashboard/credentials
ROBLOX_API_KEY=

# The universe ID of "Survive Floods for Brainrots"
ROBLOX_UNIVERSE_ID=

# The root place ID of "Survive Floods for Brainrots"
ROBLOX_PLACE_ID=

# Command prefix
PREFIX=-

# Comma-separated list of Discord user IDs with owner-level access
# Example: OWNER_IDS=123456789012345678,987654321098765432
OWNER_IDS=
