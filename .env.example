# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The application (client) ID of your Discord bot
DISCORD_CLIENT_ID=

# The guild (server) ID where commands are registered during development.
# Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Roblox Open Cloud API key from https://create.roblox.com/dashboard/credentials
ROBLOX_API_KEY=

# The universe ID of "Survive Floods for Brainrots"
ROBLOX_UNIVERSE_ID=

# The root place ID of "Survive Floods for Brainrots"
ROBLOX_PLACE_ID=
